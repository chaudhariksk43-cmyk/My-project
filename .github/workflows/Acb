name: Run Programs

on:
  workflow_dispatch:

jobs:
  run-python:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install required libraries
        run: |
          python -m pip install --upgrade pip
          pip install smartapi-python pandas numpy scikit-learn requests pyotp

      - name: Run First Program
        run: python "apex_mechanical.py"

      - name: Run Second Program
        run: python "hsshshsjjsbshzhzhzh.py"
